# ============================================================================
# IBPJ API — Variáveis de Ambiente (Produção em Nuvem / Desenvolvimento)
# ============================================================================

# 1. Conexão com o Banco de Dados PostgreSQL (Render / Railway / Supabase / Neon / Local)
DATABASE_URL="postgresql://usuario:senha@host:5432/ibpj_db?schema=public"

# 2. Porta HTTP do servidor Express (Render e Railway injetam automaticamente PORT)
PORT=4000

# 3. Chave secreta para assinatura e validação dos tokens JWT
JWT_SECRET="substitua-por-uma-chave-secreta-forte-em-producao"

# 4. Origens permitidas no CORS
# Use "*" para permitir todas as origens (incluindo APK Android capacitor://localhost e https://localhost)
# Ou separe múltiplas origens por vírgula: "https://ibpj-mobile-web.onrender.com,capacitor://localhost,https://localhost,http://localhost"
CORS_ORIGIN="*"

# 5. URL pública de produção da API (usada para gerar o QR Code e links de download)
PUBLIC_API_URL="https://ibpj-api.onrender.com"

# 6. URL pública permanente para download direto do APK (GitHub Releases ou rota local /apk/IBPJ-Mobile-release.apk)
APK_DOWNLOAD_URL="https://github.com/GelimTH/projeto-igreja-ibpj/releases/latest/download/IBPJ-Mobile-release.apk"
